<?xml version="1.0" encoding="utf-8"?>
<!-- 传统云备份排除规则（Android 11 及以下 fullBackupContent）：
     加密凭据依赖 AndroidKeyStore 密钥（不参与备份），还原后必然解密失败被静默清除，
     明文邮箱与崩溃日志也不应随云备份外流，故整体排除。
     jm_prefs DataStore 内是登录 token / 明文账号 / 手填域名，同样不得上云；
     还原后登录态回到未登录，属预期行为。 -->
<full-backup-content>
    <exclude domain="sharedpref" path="jm_secure_account.xml" />
    <exclude domain="file" path="datastore/jm_prefs.preferences_pb" />
    <exclude domain="file" path="crash" />
</full-backup-content>
